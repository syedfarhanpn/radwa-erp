# Supabase — browser-safe values only.
# The publishable key is designed to be shipped to the client; row-level
# security is what protects the data, not the secrecy of this key.
#
# NEVER put the database password or a service-role key in this file: anything
# prefixed NEXT_PUBLIC_ is compiled into the JavaScript bundle and is public.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
